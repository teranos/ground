# Compiled Object files
*.o
*.obj

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.a
*.lib

# Executables
*.exe

# Binaries
ground
ground-test-application
tools/wind
tools/press
tools/binder
tools/editor
ug/ug

# Generated
.version
.builddate
ground.db
.ctfe/*
!.ctfe/.gitkeep
result

# Debug captures
captured_hook_payload.json

# Parity captures — one moment each, and they carry a session id
captures/

# User controls — shared pbt tracked, personal pbt in controls/local/ (gitignored)
controls/*
!controls/controls.d
!controls/*.pbt
!controls/local/
controls/local/*
!controls/local/.gitkeep

# The book is generated from source, so only its inputs are tracked. A tracked
# PDF would be a second copy of the reference, free to disagree with the code.
doc/tex/
doc/provenance.tex
doc/edition.tex
doc/cases.ddoc
doc/book.pdf
doc/book.folios
doc/annot.pdf
doc/annot.folios
doc/html/
doc/book.html
doc/book.css
doc/*.4ct
doc/*.4tc
doc/*.idv
doc/*.lg
doc/*.tmp
doc/*.xref
doc/*.dvi
doc/*.aux
doc/*.log
doc/*.out
doc/*.toc
doc/*.fls
doc/*.fdb_latexmk
doc/*.xdv

# DUB
.dub
docs.json
__dummy.html
docs/

# Code coverage
*.lst

# Ritual worktrees. A performance builds a sibling of the tree it names, and
# grove now names one inside this repo.
grove-*/
