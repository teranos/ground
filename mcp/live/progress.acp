# A tool's progress, with a message, is the call's content while it runs; the step with none says nothing; the call asks on its own id.
{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"protocolVersion":1}}
wait 0
{"jsonrpc":"2.0","id":1,"method":"session/new","params":{"cwd":"$CWD","mcpServers":[{"name":"test","command":"/usr/bin/env","args":["python3","$LIVE/../mcp/progress_server.py"],"env":[]}]}}
wait 1
{"jsonrpc":"2.0","id":2,"method":"session/set_mode","params":{"sessionId":"$SID","modeId":"bypassPermissions"}}
wait 2
{"jsonrpc":"2.0","id":3,"method":"session/prompt","params":{"sessionId":"$SID","prompt":[{"type":"text","text":"Call test__count once, then reply with only: done"}]}}
wait 3
