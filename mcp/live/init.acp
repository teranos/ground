# initialize in the v1 and v2 request shapes, a version none fits, none named; authenticate; a v2-shaped client's elicitation.
{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"protocolVersion":1,"clientCapabilities":{"fs":{"readTextFile":true}}}}
wait 0
restart
{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"protocolVersion":2,"info":{"name":"probe","version":"1"},"capabilities":{"elicitation":{"form":{}}}}}
wait 0
restart
{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"protocolVersion":0}}
wait 0
restart
{"jsonrpc":"2.0","id":0,"method":"initialize","params":{}}
wait 0
restart
# authenticate: ground code advertises no auth methods; a methodId only in _meta is none.
{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"protocolVersion":1}}
wait 0
{"jsonrpc":"2.0","id":1,"method":"authenticate","params":{"methodId":"openrouter"}}
wait 1
{"jsonrpc":"2.0","id":2,"method":"authenticate","params":{}}
wait 2
{"jsonrpc":"2.0","id":3,"method":"authenticate","params":{"_meta":{"methodId":"openrouter"}}}
wait 3
restart
# A v2-shaped client offering form elicitation is spoken to at v1, and its session's server is still asked.
{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"protocolVersion":2,"info":{"name":"probe","version":"1"},"capabilities":{"elicitation":{"form":{}}}}}
wait 0
{"jsonrpc":"2.0","id":1,"method":"session/new","params":{"cwd":"$CWD","mcpServers":[{"name":"elicit","command":"$LIVE/elicit_server","args":[],"env":[{"name":"ELICIT_PROTOCOL","value":"legacy"},{"name":"ELICIT_LOG","value":"$CWD/elicit.log"}]}]}}
wait 1
{"jsonrpc":"2.0","id":2,"method":"session/set_mode","params":{"sessionId":"$SID","modeId":"bypassPermissions"}}
wait 2
{"jsonrpc":"2.0","id":3,"method":"session/prompt","params":{"sessionId":"$SID","prompt":[{"type":"text","text":"Call the elicit tool `ask` with no arguments, then reply with only: done"}]}}
expect "method":"elicitation/create"
{"jsonrpc":"2.0","id":$ASKED,"result":{"action":"accept","content":{"branch":"main"}}}
wait 3
cat $CWD/elicit.log
