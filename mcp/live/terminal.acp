# terminal/*: the model's run_command, allowed in Manual, runs in the client's terminal; a cancel kills it; the client's error is the call's.
{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"protocolVersion":1,"clientCapabilities":{"terminal":true}}}
wait 0
{"jsonrpc":"2.0","id":1,"method":"session/new","params":{"cwd":"$CWD","mcpServers":[]}}
wait 1
{"jsonrpc":"2.0","id":2,"method":"session/prompt","params":{"sessionId":"$SID","prompt":[{"type":"text","text":"Use run_command once to run echo with the one argument ground, then reply with only what it printed."}]}}
expect "method":"session/request_permission"
{"jsonrpc":"2.0","id":$ASKED,"result":{"outcome":{"outcome":"selected","optionId":"allow_once"}}}
expect "method":"terminal/create"
{"jsonrpc":"2.0","id":$ASKED,"result":{"terminalId":"live-1"}}
expect "method":"terminal/wait_for_exit"
{"jsonrpc":"2.0","id":$ASKED,"result":{"exitCode":0,"signal":null}}
expect "method":"terminal/output"
{"jsonrpc":"2.0","id":$ASKED,"result":{"output":"ground\n","truncated":false,"exitStatus":{"exitCode":0,"signal":null}}}
expect "method":"terminal/release"
{"jsonrpc":"2.0","id":$ASKED,"result":{}}
wait 2
# Called off while it runs: killed, read and released, and the turn stops cancelled.
{"jsonrpc":"2.0","id":3,"method":"session/prompt","params":{"sessionId":"$SID","prompt":[{"type":"text","text":"Use run_command once to run sleep with the one argument 60, then reply with only: done"}]}}
expect "method":"session/request_permission"
{"jsonrpc":"2.0","id":$ASKED,"result":{"outcome":{"outcome":"selected","optionId":"allow_once"}}}
expect "method":"terminal/create"
{"jsonrpc":"2.0","id":$ASKED,"result":{"terminalId":"live-2"}}
expect "method":"terminal/wait_for_exit"
{"jsonrpc":"2.0","method":"session/cancel","params":{"sessionId":"$SID"}}
expect "method":"terminal/kill"
{"jsonrpc":"2.0","id":$ASKED,"result":{}}
expect "method":"terminal/output"
{"jsonrpc":"2.0","id":$ASKED,"result":{"output":"","truncated":false}}
expect "method":"terminal/release"
{"jsonrpc":"2.0","id":$ASKED,"result":{}}
wait 3
# The client cannot create it: the call fails with the client's own error, and the model is told.
{"jsonrpc":"2.0","id":4,"method":"session/prompt","params":{"sessionId":"$SID","prompt":[{"type":"text","text":"Use run_command once more to run echo with the one argument ground, then reply with only what the tool answered."}]}}
expect "method":"session/request_permission"
{"jsonrpc":"2.0","id":$ASKED,"result":{"outcome":{"outcome":"selected","optionId":"allow_once"}}}
expect "method":"terminal/create"
{"jsonrpc":"2.0","id":$ASKED,"error":{"code":-32603,"message":"no shell"}}
wait 4
