{
    "name": "ground",
    "version": "0.19.1",
    "description": "Workflow enforcement for Claude Code",
    "targetType": "executable",
    "targetName": "ground",
    "sourcePaths": ["source"],
    "mainSourceFile": "source/main.d",
    "stringImportPaths": ["."],
    "dflags": ["-betterC", "--lowmem"],
    "libs": ["sqlite3", "curl", "git2"],
    "extraDependencyFiles": [".ctfe/sand"],
    "preBuildCommands": ["date -u +%Y-%m-%dT%H:%M:%SZ > .builddate", "tools/wind"],

    "configurations": [
        {
            "name": "application"
        },
        {
            "name": "production",
            "excludedSourceFiles": ["source/*_test.d"]
        }
    ]
}
