{
    "name": "ground",
    "version": "0.19.1",
    "description": "Workflow enforcement for Claude Code",
    "targetType": "executable",
    "targetName": "ground",
    "sourcePaths": ["source"],
    "mainSourceFile": "source/main.d",
    "stringImportPaths": ["."],
    "dflags": ["-betterC", "--lowmem", "-d-version=Floor"],
    "libs": ["sqlite3", "curl", "git2", "mcp", "acp", "json-c", "phonenumber"],
    "libs-posix": ["m", "pthread"],
    "libs-linux": ["dl", "stdc++"],
    "libs-osx": ["iconv", "c++"],
    "sourceFiles": ["build/phone.o"],
    "extraDependencyFiles": [".ctfe/sand", "phone/phone.cc"],
    "preBuildCommands": ["date -u +%Y-%m-%dT%H:%M:%SZ > .builddate", "tools/wind", "mkdir -p build", "c++ -std=c++20 -O2 -c phone/phone.cc -o build/phone.o"],

    "configurations": [
        {
            "name": "application"
        },
        {
            "name": "production",
            "excludedSourceFiles": ["source/*_test.d", "source/parity.d", "source/shipped.d"]
        }
    ]
}
