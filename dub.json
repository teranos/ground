{
    "name": "ground",
    "description": "Workflow enforcement for Claude Code",
    "targetType": "executable",
    "targetName": "ground",
    "sourcePaths": ["source"],
    "mainSourceFile": "source/main.d",
    "stringImportPaths": ["."],
    "dflags": ["-betterC", "--lowmem"],
    "extraDependencyFiles": [".ctfe/sand"],
    "preBuildCommands": ["git describe --tags --always > .version || true", "date -u +%Y-%m-%dT%H:%M:%SZ > .builddate", "tools/wind"],

    "configurations": [
        {
            "name": "application",
            "libs": ["sqlite3"]
        },
        {
            "name": "production",
            "excludedSourceFiles": ["source/*_test.d"],
            "libs": ["sqlite3"]
        },
        {
            "name": "production-static",
            "excludedSourceFiles": ["source/*_test.d"],
            "libs": ["sqlite3"],
            "lflags": ["-static"]
        },
        {
            "name": "production-static-sqlite",
            "excludedSourceFiles": ["source/*_test.d"],
            "lflags": ["$SQLITE_STATIC_LIB"]
        }
    ]
}
