#!/bin/sh
# Run a command under a hard resident-memory ceiling, and always report the peak.
#
# WHY THIS EXISTS
#   ground evaluates every control at compile time. LDC's CTFE interpreter
#   allocates into an arena it never frees, so build memory is a function of the
#   control set and the size of the structs the parser copies, not of anything
#   the build reports. On 2026-07-27 a release build exhausted an 8GB machine,
#   took the system down, and destroyed a working session. The build had no
#   ceiling and no gauge, so the cause was guessed at rather than measured.
#
#   An unbounded build is not a build. It is a gamble with the machine as stake.
#
# WHAT IT DOES
#   1. Runs the command in the background QoS band (taskpolicy -b) so the kernel
#      deprioritizes its memory and raises its jetsam kill priority. The machine
#      stays usable while it runs, and under pressure the kernel takes the
#      compiler rather than stalling the UI.
#   2. Polls the resident size of the entire process tree and kills it outright
#      past the ceiling. RLIMIT_AS exists on Darwin but is not reliably
#      enforced, so a poller is the honest mechanism rather than the elegant one.
#   3. Reports peak resident size on every run, pass or fail, and appends it to
#      .buildmem so the trend is visible instead of rediscovered.
#
# USAGE
#   tools/capped dub build --build=release
#   GROUND_BUILD_MEM_MB=1500 tools/capped dub build --build=release

set -u

CAP_MB=${GROUND_BUILD_MEM_MB:-3000}
# kern.memorystatus_level is the percentage of memory the kernel considers
# available, and it is the same number jetsam consults before it starts killing
# things. Tripping above jetsam's own threshold is what keeps the decision ours
# rather than the kernel's, and keeps the victim the compiler rather than a
# session, an editor, or the window server.
#
# This is the condition that actually protects the machine. The resident ceiling
# below does not: the kernel compresses a background process's pages, so RSS can
# read far under what a process is really demanding.
FLOOR_PCT=${GROUND_BUILD_MEM_FLOOR:-20}
POLL_SECONDS=${GROUND_BUILD_POLL:-0.25}
CAP_KB=$((CAP_MB * 1024))
PEAK_KB=0
LOWEST_PCT=100
TREE_PIDS=""

if [ $# -lt 1 ]; then
    echo "usage: tools/capped <command> [args...]" >&2
    exit 64
fi

HERE=$(dirname "$0")
HISTORY="$HERE/../.buildmem"

SNAPSHOT=$(mktemp -t ground-capped)
trap 'rm -f "$SNAPSHOT"' EXIT INT TERM

# Sum resident KB across the command and every process descended from it, and
# leave the pid set in TREE_PIDS so the killer targets the same tree it measured.
#
# The process table is not ordered parent-before-child, so one pass can miss a
# grandchild whose parent appears later in the listing. Repeat until the set
# stops growing. Six passes is well past any depth dub and ldc2 produce.
measure_tree() {
    ps -axo pid=,ppid=,rss= > "$SNAPSHOT"

    TREE_PIDS=" $BUILD_PID "
    pass=0
    while [ "$pass" -lt 6 ]; do
        pass=$((pass + 1))
        added=0
        while read -r pid ppid rss; do
            case "$TREE_PIDS" in
                *" $pid "*) continue ;;
            esac
            case "$TREE_PIDS" in
                *" $ppid "*)
                    TREE_PIDS="$TREE_PIDS$pid "
                    added=1
                    ;;
            esac
        done < "$SNAPSHOT"
        [ "$added" -eq 0 ] && break
    done

    total_kb=0
    while read -r pid ppid rss; do
        case "$TREE_PIDS" in
            *" $pid "*) total_kb=$((total_kb + rss)) ;;
        esac
    done < "$SNAPSHOT"

    echo "$total_kb"
}

kill_tree() {
    for pid in $TREE_PIDS; do
        kill -9 "$pid" 2>/dev/null
    done
}

mb() {
    echo $(($1 / 1024))
}

system_available_pct() {
    sysctl -n kern.memorystatus_level 2>/dev/null || echo 100
}

record() {
    stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    version=$(tr -d '\n' < "$HERE/../.version" 2>/dev/null)
    printf '%s\t%s\tpeak=%sMB\tfree_low=%s%%\t%ss\t%s\n' \
        "$stamp" "$1" "$(mb "$PEAK_KB")" "$LOWEST_PCT" "$2" "$version" >> "$HISTORY"
}

START=$(date +%s)

taskpolicy -b "$@" &
BUILD_PID=$!

while kill -0 "$BUILD_PID" 2>/dev/null; do
    CURRENT_KB=$(measure_tree)
    [ "$CURRENT_KB" -gt "$PEAK_KB" ] && PEAK_KB=$CURRENT_KB

    AVAILABLE_PCT=$(system_available_pct)
    [ "$AVAILABLE_PCT" -lt "$LOWEST_PCT" ] && LOWEST_PCT=$AVAILABLE_PCT

    # System floor first. It is the condition that protects the machine, and it
    # holds even when the tree's resident size looks harmless because the kernel
    # has compressed it.
    if [ "$AVAILABLE_PCT" -lt "$FLOOR_PCT" ]; then
        kill_tree
        ELAPSED=$(($(date +%s) - START))
        record floor "$ELAPSED"
        echo "" >&2
        echo "capped: killed the build. System memory available fell to ${AVAILABLE_PCT}%, floor is ${FLOOR_PCT}%." >&2
        echo "capped: tree was $(mb "$CURRENT_KB")MB resident, peak $(mb "$PEAK_KB")MB, after ${ELAPSED}s." >&2
        echo "capped: the machine was never handed to jetsam. Nothing else was killed." >&2
        exit 70
    fi

    if [ "$CURRENT_KB" -gt "$CAP_KB" ]; then
        kill_tree
        ELAPSED=$(($(date +%s) - START))
        record killed "$ELAPSED"
        echo "" >&2
        echo "capped: killed the build at $(mb "$CURRENT_KB")MB resident, ceiling is ${CAP_MB}MB." >&2
        echo "capped: peak $(mb "$PEAK_KB")MB after ${ELAPSED}s, system stayed above ${LOWEST_PCT}% free." >&2
        echo "capped: raise it with GROUND_BUILD_MEM_MB if the ceiling is the wrong call." >&2
        exit 70
    fi

    sleep "$POLL_SECONDS"
done

wait "$BUILD_PID"
STATUS=$?
ELAPSED=$(($(date +%s) - START))

if [ "$STATUS" -eq 0 ]; then
    record ok "$ELAPSED"
    echo "capped: peak $(mb "$PEAK_KB")MB, system low-water ${LOWEST_PCT}% free, ${ELAPSED}s, ceiling ${CAP_MB}MB." >&2
else
    record "exit$STATUS" "$ELAPSED"
    echo "capped: command exited $STATUS. Peak $(mb "$PEAK_KB")MB, system low-water ${LOWEST_PCT}% free, ${ELAPSED}s." >&2
fi

exit "$STATUS"
